---
import type { Episode } from '../utils/rss';

interface Props {
  episodes: Episode[];
  showViewAll?: boolean;
}

const { episodes, showViewAll = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="episodes" class="episodes-section">
  <div class="container">
    <div class="ep-header">
      <div>
        <span class="eyebrow">Listen</span>
        <h2 class="section-heading">Recent Episodes</h2>
      </div>
      {showViewAll && (
        <a href={`${base}/episodes`} class="view-all">
          <span>View All Episodes</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      )}
    </div>

    <div class="ep-grid">
      {episodes.map((ep) => (
        <article class="ep-card">
          <div class="ep-meta">
            <span class="ep-badge">{ep.episodeNumber}</span>
            <span>{ep.formattedDate}</span>
            <span class="ep-dur">{ep.duration}</span>
          </div>

          <h3 class="ep-title">{ep.cleanTitle}</h3>
          <p class="ep-excerpt">{ep.plainExcerpt}</p>

          <div class="ep-footer">
            {ep.audioUrl && (
              <audio controls preload="none" src={ep.audioUrl}></audio>
            )}
            <a href={ep.link} target="_blank" rel="noopener noreferrer" class="ep-link">
              Open in Spotify ↗
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .episodes-section {
    padding: 5.5rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .ep-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.75rem;
    flex-wrap: wrap;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.2rem;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .view-all:hover {
    border-color: var(--border-hover);
    background: var(--bg-elevated);
  }

  .ep-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 1.5rem;
  }

  .ep-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .ep-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .ep-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 0.85rem;
  }

  .ep-badge {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.74rem;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  .ep-dur {
    margin-left: auto;
  }

  .ep-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.65rem;
  }

  .ep-excerpt {
    color: var(--text-secondary);
    font-size: 0.92rem;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .ep-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ep-link {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .ep-link:hover {
    color: var(--text-primary);
  }
</style>
