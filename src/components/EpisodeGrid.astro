---
import type { Episode } from '../utils/rss';

interface Props {
  episodes: Episode[];
  showViewAll?: boolean;
}

const { episodes, showViewAll = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="episodes" class="episodes-section" data-ep-section>
  <div class="container">
    <div class="ep-header">
      <div>
        <span class="eyebrow">Listen</span>
        <h2 class="section-heading">Recent Episodes</h2>
      </div>

      <div class="ep-controls">
        <!-- View Switcher: List (default) vs Tiles -->
        <div class="view-toggle" role="group" aria-label="Episode layout view">
          <button
            type="button"
            class="toggle-btn active"
            data-view-btn="list"
            aria-pressed="true"
            title="Expandable List view"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            <span>List</span>
          </button>
          <button
            type="button"
            class="toggle-btn"
            data-view-btn="grid"
            aria-pressed="false"
            title="Grid tiles view"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span>Tiles</span>
          </button>
        </div>

        {showViewAll && (
          <a href={`${base}/episodes`} class="view-all">
            <span>View All Episodes</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        )}
      </div>
    </div>

    <!-- Default to Expandable List Mode -->
    <div class="ep-container is-list" data-ep-container>
      {episodes.map((ep, idx) => {
        const thumbSrc = ep.image.startsWith('/') ? `${base}${ep.image}` : ep.image;
        return (
          <article class={`ep-card ${idx === 0 ? 'is-open' : ''}`} data-ep-item>
            <!-- Compact Clickable Row Header -->
            <button
              type="button"
              class="ep-row-trigger"
              data-ep-trigger
              aria-expanded={idx === 0 ? 'true' : 'false'}
            >
              <div class="ep-row-left">
                <span class="ep-badge">{ep.episodeNumber}</span>
                <h3 class="ep-title">{ep.cleanTitle}</h3>
              </div>

              <div class="ep-row-right">
                <span class="ep-date">{ep.formattedDate}</span>
                <span class="ep-dur">{ep.duration}</span>
                <span class="ep-chevron" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </div>
            </button>

            <!-- Expandable Drawer with Episode Artwork Thumbnail, Description & Audio Player -->
            <div class="ep-drawer">
              <div class="ep-drawer-inner">
                <div class="ep-thumb-wrap">
                  <img
                    src={thumbSrc}
                    alt={ep.cleanTitle}
                    loading="lazy"
                    width="180"
                    height="180"
                    class="ep-thumb"
                  />
                </div>

                <div class="ep-details">
                  <div class="ep-grid-meta">
                    <span class="ep-badge">{ep.episodeNumber}</span>
                    <span>{ep.formattedDate}</span>
                    <span>• {ep.duration}</span>
                  </div>
                  <h3 class="ep-grid-title">{ep.cleanTitle}</h3>
                  <p class="ep-excerpt">{ep.plainExcerpt}</p>

                  <div class="ep-player-bar">
                    {ep.audioUrl && (
                      <audio controls preload="none" src={ep.audioUrl}></audio>
                    )}
                    <div class="ep-actions">
                      <a href={ep.link} target="_blank" rel="noopener noreferrer" class="ep-link">
                        <span>Listen on Spotify</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-ep-section]').forEach((section) => {
    const container = section.querySelector('[data-ep-container]');
    const viewButtons = section.querySelectorAll('[data-view-btn]');
    const items = section.querySelectorAll('[data-ep-item]');

    // Toggle List vs Tiles mode
    viewButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-view-btn');
        if (!container || !mode) return;

        viewButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        if (mode === 'grid') {
          container.classList.remove('is-list');
          container.classList.add('is-grid');
        } else {
          container.classList.remove('is-grid');
          container.classList.add('is-list');
        }
      });
    });

    // Accordion expand/collapse on click in List view (auto-collapse others)
    items.forEach((item) => {
      const trigger = item.querySelector('[data-ep-trigger]');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        if (!container?.classList.contains('is-list')) return;
        const wasOpen = item.classList.contains('is-open');

        // Close all items first (and pause any playing audio inside collapsed rows)
        items.forEach((otherItem) => {
          otherItem.classList.remove('is-open');
          const otherTrigger = otherItem.querySelector('[data-ep-trigger]');
          if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
        });

        // If the clicked item wasn't already open, open it
        if (!wasOpen) {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

<style>
  .episodes-section {
    padding: 5.5rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .ep-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.25rem;
    flex-wrap: wrap;
  }

  .ep-controls {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .view-toggle {
    display: inline-flex;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.25rem;
    gap: 0.25rem;
  }

  .toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .toggle-btn:hover {
    color: var(--text-primary);
  }

  .toggle-btn.active {
    background: var(--bg-elevated);
    color: var(--text-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.2rem;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .view-all:hover {
    border-color: var(--border-hover);
    background: var(--bg-elevated);
  }

  /* Shared Card Container */
  .ep-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    overflow: hidden;
  }

  .ep-card:hover {
    border-color: var(--border-hover);
  }

  .ep-badge {
    background: rgba(230, 36, 41, 0.14);
    color: var(--accent-red);
    font-weight: 700;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    flex-shrink: 0;
  }

  /* =========================================
     LIST VIEW (Expandable Accordion Rows)
     ========================================= */
  .ep-container.is-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ep-container.is-list .ep-grid-meta,
  .ep-container.is-list .ep-grid-title {
    display: none;
  }

  .ep-row-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-body);
    text-align: left;
    cursor: pointer;
  }

  .ep-row-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .ep-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ep-row-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
    font-size: 0.84rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .ep-chevron {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    transition: transform 0.25s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .ep-card.is-open .ep-chevron {
    transform: rotate(180deg);
    background: rgba(230, 36, 41, 0.15);
    color: var(--accent-red);
  }

  .ep-container.is-list .ep-drawer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ep-container.is-list .ep-card.is-open .ep-drawer {
    grid-template-rows: 1fr;
  }

  .ep-container.is-list .ep-drawer-inner {
    overflow: hidden;
    display: grid;
    grid-template-columns: 165px 1fr;
    gap: 1.75rem;
    align-items: center;
    padding: 0 1.5rem;
  }

  .ep-container.is-list .ep-card.is-open .ep-drawer-inner {
    padding: 0.25rem 1.5rem 1.5rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.35rem;
  }

  /* =========================================
     TILES / GRID VIEW
     ========================================= */
  .ep-container.is-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 1.5rem;
  }

  .ep-container.is-grid .ep-row-trigger {
    display: none;
  }

  .ep-container.is-grid .ep-drawer-inner {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    height: 100%;
    gap: 1.25rem;
  }

  .ep-container.is-grid .ep-thumb-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
  }

  .ep-container.is-grid .ep-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ep-grid-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  .ep-grid-title {
    font-family: var(--font-heading);
    font-size: 1.22rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  /* Shared Thumbnail & Details */
  .ep-thumb-wrap {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: #0c0e13;
    flex-shrink: 0;
  }

  .ep-thumb {
    width: 165px;
    height: 165px;
    object-fit: cover;
    display: block;
  }

  .ep-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .ep-excerpt {
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .ep-player-bar {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .ep-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .ep-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .ep-link:hover {
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .ep-title {
      white-space: normal;
      font-size: 1.02rem;
    }
    .ep-dur {
      display: none;
    }
    .ep-container.is-list .ep-drawer-inner {
      grid-template-columns: 1fr;
      gap: 1.15rem;
    }
    .ep-thumb {
      width: 130px;
      height: 130px;
    }
  }
</style>
