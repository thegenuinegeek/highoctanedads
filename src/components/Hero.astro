---
import { SITE_CONFIG } from '../config';
import type { Episode } from '../utils/rss';

interface Props {
  latestEpisode: Episode;
}

const { latestEpisode } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-top">
      <div class="hero-text">
        <div class="badge-pill">
          <span class="dot"></span>
          <span>New Episodes Every Saturday</span>
        </div>

        <h1 class="hero-title">
          Two Dads. Fast Cars.<br />
          <span>Zero Filter.</span>
        </h1>

        <p class="hero-subtitle">
          Join <strong>James Schoepf</strong> and <strong>Chris Mayo</strong> for weekly garage talk, LS-swapped third-gen F-body builds, motorsports, and the reality of fatherhood in the fast lane.
        </p>

        <div class="platform-bar">
          <a href={SITE_CONFIG.links.youtube} target="_blank" rel="noopener noreferrer" class="plat-pill primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            <span>Watch on YouTube</span>
          </a>

          <a href={SITE_CONFIG.links.spotify} target="_blank" rel="noopener noreferrer" class="plat-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
            <span>Spotify</span>
          </a>

          <a href={SITE_CONFIG.links.apple} target="_blank" rel="noopener noreferrer" class="plat-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M5.34 0A5.328 5.328 0 0 0 0 5.34v13.32A5.328 5.328 0 0 0 5.34 24h13.32A5.328 5.328 0 0 0 24 18.66V5.34A5.328 5.328 0 0 0 18.66 0zm6.525 2.568c2.336 0 4.448.902 6.056 2.587 1.224 1.272 1.912 2.619 2.264 4.392.12.59.12 2.2 0 2.864-.312 1.696-1.088 3.168-2.312 4.392-1.168 1.168-2.752 1.968-4.4 2.224-.496.08-.76.008-.92-.248-.12-.192-.112-.528.016-.728.112-.176.296-.24.792-.328 1.992-.352 3.696-1.488 4.744-3.168.736-1.184 1.08-2.464 1.08-3.984 0-1.696-.44-3.08-1.368-4.32-1.304-1.736-3.288-2.744-5.584-2.84-2.472-.104-4.744.912-6.2 2.776-1.024 1.312-1.528 2.792-1.528 4.496 0 1.488.352 2.792 1.064 3.936 1.04 1.672 2.736 2.816 4.728 3.184.496.088.68.152.792.328.128.2.136.536.016.728-.16.256-.424.328-.92.248-1.648-.256-3.232-1.056-4.4-2.224-1.224-1.224-2-2.696-2.312-4.392-.12-.664-.12-2.274 0-2.864.352-1.773 1.04-3.12 2.264-4.392 1.608-1.685 3.72-2.587 6.056-2.587zm.135 3.624c1.904 0 3.64 1.048 4.504 2.72.344.664.528 1.368.552 2.16.048 1.544-.568 2.976-1.744 4.024-.344.304-.688.456-.96.416-.368-.056-.584-.456-.44-.808.072-.176.2-.296.496-.528.888-.704 1.368-1.688 1.368-2.816 0-1.992-1.568-3.664-3.544-3.776-2.16-.12-3.968 1.568-3.968 3.712 0 1.184.48 2.168 1.392 2.872.296.232.424.352.496.528.144.352-.072.752-.44.808-.272.04-.616-.112-.96-.416-1.176-1.048-1.792-2.48-1.744-4.024.024-.792.208-1.496.552-2.16.864-1.672 2.6-2.72 4.504-2.72zm-.048 3.312c.992 0 1.8.808 1.8 1.8a1.802 1.802 0 0 1-1.056 1.64l.512 4.352c.064.544-.04 1.008-.312 1.352-.288.368-.72.568-1.224.568h-.448c-.504 0-.936-.2-1.224-.568-.272-.344-.376-.808-.312-1.352l.512-4.352a1.802 1.802 0 0 1-1.056-1.64c0-.992.808-1.8 1.808-1.8z"/></svg>
            <span>Apple Podcasts</span>
          </a>
        </div>
      </div>

      <div class="hero-logo-card">
        <img
          src={`${base}/images/HOD-Logo-2024.png`}
          alt="High Octane Dads Podcast"
          width="280"
          height="280"
        />
      </div>
    </div>

    <!-- Sleek Featured Episode Player Bar -->
    <div class="featured-episode">
      <div class="fe-header">
        <div class="fe-badge">
          <span class="fe-tag">LATEST EPISODE</span>
          <span class="fe-meta">{latestEpisode.episodeNumber} • {latestEpisode.formattedDate} • {latestEpisode.duration}</span>
        </div>
        <a href={`${base}/episodes`} class="fe-all">All 40+ Episodes →</a>
      </div>

      <div class="fe-main">
        <div class="fe-info">
          <h2 class="fe-title">{latestEpisode.cleanTitle}</h2>
          <p class="fe-desc">{latestEpisode.plainExcerpt}</p>
        </div>

        {latestEpisode.audioUrl && (
          <div class="fe-player">
            <audio controls preload="none" src={latestEpisode.audioUrl}></audio>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 5.5rem 0 4rem;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: -180px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 420px;
    background: radial-gradient(circle, rgba(230, 36, 41, 0.14) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-top {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 4rem;
    align-items: center;
    margin-bottom: 4rem;
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-red);
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 5.5vw, 4.35rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.06;
    margin-bottom: 1.35rem;
  }

  .hero-title span {
    color: var(--accent-red);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 560px;
    margin-bottom: 2.25rem;
  }

  .hero-subtitle strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .platform-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .plat-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 1.3rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    transition: all 0.2s ease;
  }

  .plat-pill:hover {
    border-color: var(--border-hover);
    background: var(--bg-elevated);
    transform: translateY(-1px);
  }

  .plat-pill.primary {
    background: var(--accent-red);
    border-color: var(--accent-red);
    color: #fff;
  }

  .plat-pill.primary:hover {
    background: #f42a30;
  }

  .hero-logo-card {
    background: radial-gradient(circle, #ffffff 0%, #f1f5f9 100%);
    border-radius: 28px;
    padding: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 320px;
    margin-left: auto;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }

  /* Featured Episode Card */
  .featured-episode {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 2rem 2.25rem;
  }

  .fe-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .fe-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .fe-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: rgba(230, 36, 41, 0.15);
    color: var(--accent-red);
  }

  .fe-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .fe-all {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .fe-all:hover {
    color: var(--text-primary);
  }

  .fe-main {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2.5rem;
    align-items: center;
  }

  .fe-title {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .fe-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .hero {
      padding: 3.5rem 0 3rem;
    }
    .hero-top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .hero-logo-card {
      margin: 0;
      max-width: 220px;
      padding: 1.5rem;
    }
    .fe-main {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .featured-episode {
      padding: 1.5rem;
    }
  }
</style>
