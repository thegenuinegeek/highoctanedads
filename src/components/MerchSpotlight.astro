---
import { SITE_CONFIG } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="merch-section">
  <div class="container">
    <div class="merch-card">
      <div class="merch-copy">
        <span class="eyebrow">Official Gear</span>
        <h2 class="section-heading">Rep the High Octane Dads</h2>
        <p class="merch-desc">
          Grab the <strong>“Zero to 60 Eventually”</strong> shirt, hats, and garage gear over at our official shop. Every order helps keep the podcast and project cars rolling.
        </p>
        <a
          href={SITE_CONFIG.links.merch}
          target="_blank"
          rel="noopener noreferrer"
          class="merch-btn"
        >
          <span>Shop Merch Store</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
      </div>

      <div class="merch-visual">
        <div class="badge-glow" aria-hidden="true"></div>
        <img
          src={`${base}/images/high-octane-dads-est-qr.png`}
          alt="High Octane Dads Est 2023 Send It QR Badge"
          width="260"
          height="260"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .merch-section {
    padding: 1.5rem 0 4.5rem;
  }

  .merch-card {
    background: linear-gradient(135deg, #171215 0%, #111318 100%);
    border: 1px solid rgba(230, 36, 41, 0.28);
    border-radius: 24px;
    padding: 2.75rem 3.5rem;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: center;
    gap: 2.5rem;
    overflow: hidden;
  }

  .merch-copy {
    max-width: 580px;
  }

  .merch-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    margin: 0.85rem 0 1.75rem;
  }

  .merch-desc strong {
    color: var(--text-primary);
  }

  .merch-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    background: var(--accent-red);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .merch-btn:hover {
    background: #f42a30;
    transform: translateY(-1px);
  }

  .merch-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .badge-glow {
    position: absolute;
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, rgba(230, 36, 41, 0.22) 0%, transparent 70%);
    pointer-events: none;
  }

  .merch-visual img {
    position: relative;
    width: 245px;
    height: 245px;
    flex-shrink: 0;
    filter: drop-shadow(0 16px 32px rgba(0, 0, 0, 0.55));
    transition: transform 0.3s ease;
  }

  .merch-card:hover .merch-visual img {
    transform: scale(1.04) rotate(3deg);
  }

  @media (max-width: 768px) {
    .merch-card {
      grid-template-columns: 1fr;
      padding: 2rem;
    }
    .merch-visual img {
      width: 200px;
      height: 200px;
    }
  }
</style>
