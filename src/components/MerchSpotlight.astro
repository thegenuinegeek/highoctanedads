---
import { SITE_CONFIG } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="merch-section">
  <div class="container">
    <div class="merch-banner">
      <div class="merch-stripes" aria-hidden="true"></div>

      <div class="merch-content">
        <div class="dash-tag">OFFICIAL SPEED SHOP // SUPPORT THE SHOW</div>
        <h2 class="merch-title">
          REP THE <span class="red-span">HIGH OCTANE DADS</span> PIT CREW
        </h2>
        <p class="merch-desc">
          From the fan-favorite <strong>“Zero to 60 Eventually”</strong> tees to garage-ready shirts, hats, and stickers—grab your official High Octane Dads gear and support the podcast.
        </p>

        <div class="merch-actions">
          <a
            href={SITE_CONFIG.links.merch}
            target="_blank"
            rel="noopener noreferrer"
            class="shop-cta-btn"
          >
            <span>VISIT SHOP.HIGHOCTANEDADS.COM</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
          </a>
          <span class="merch-note">Ships straight to your garage or driveway.</span>
        </div>
      </div>

      <div class="merch-badge-col">
        <div class="badge-showcase">
          <img
            src={`${base}/images/high-octane-dads-est-qr.png`}
            alt="High Octane Dads Est 2023 Send It Badge"
            width="190"
            height="190"
            class="spin-hover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .merch-section {
    padding: 2rem 0 5rem;
  }

  .merch-banner {
    position: relative;
    background: linear-gradient(125deg, #1b0d10 0%, #12151f 55%, #1d150b 100%);
    border: 2px solid var(--red-octane);
    border-radius: 14px;
    padding: 3rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    align-items: center;
    overflow: hidden;
    box-shadow: 0 20px 55px rgba(240, 30, 35, 0.2);
  }

  .merch-stripes {
    position: absolute;
    right: -60px;
    top: -40px;
    width: 260px;
    height: 400px;
    background: repeating-linear-gradient(
      -45deg,
      rgba(240, 30, 35, 0.08),
      rgba(240, 30, 35, 0.08) 18px,
      transparent 18px,
      transparent 36px
    );
    pointer-events: none;
  }

  .merch-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.8vw, 2.85rem);
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0.9rem 0 1rem;
  }

  .red-span {
    color: var(--red-octane);
  }

  .merch-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 620px;
    margin-bottom: 1.75rem;
  }

  .merch-desc strong {
    color: var(--text-primary);
  }

  .merch-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .shop-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: var(--red-octane);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-style: italic;
    font-size: 1rem;
    letter-spacing: 0.08em;
    padding: 0.95rem 1.75rem;
    border-radius: 6px;
    box-shadow: 0 8px 25px var(--red-glow);
    transition: all 0.2s ease;
  }

  .shop-cta-btn:hover {
    background: #ff2d32;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(240, 30, 35, 0.65);
  }

  .merch-note {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--transam-gold);
  }

  .badge-showcase {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 50%;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spin-hover {
    transition: transform 0.35s ease;
  }

  .merch-banner:hover .spin-hover {
    transform: rotate(6deg) scale(1.04);
  }

  @media (max-width: 820px) {
    .merch-banner {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
      text-align: left;
    }
    .merch-badge-col {
      display: flex;
      justify-content: center;
    }
  }
</style>
