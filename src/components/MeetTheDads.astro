---
import { SITE_CONFIG } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="about" class="about-section">
  <div class="container">
    <div class="section-intro">
      <span class="eyebrow">The Hosts</span>
      <h2 class="section-heading">Meet James &amp; Chris</h2>
      <p class="section-lead">
        A couple of dads who love all things fast and loud—bringing you real garage conversations every Saturday.
      </p>
    </div>

    <!-- Clean 2-Column Host Profiles -->
    <div class="hosts-grid">
      {SITE_CONFIG.hosts.map((host) => (
        <article class="host-card">
          <div class="host-top">
            <span class="host-role">{host.handle}</span>
            <h3 class="host-name">{host.name}</h3>
          </div>
          <p class="host-bio">{host.bio}</p>
          <div class="host-tags">
            {host.specs.map((spec) => (
              <div class="tag-item">
                <span class="tag-label">{spec.label}</span>
                <span class="tag-value">{spec.value}</span>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>

    <!-- Clean Origin Story Card: Mullet Militia & Twin 1986 Trans Ams -->
    <div id="garage" class="origin-card">
      <div class="origin-text">
        <span class="eyebrow">Our Origin Story</span>
        <h3 class="origin-title">Mullet Militia &amp; Twin LS-Swapped 1986 Trans Ams</h3>
        <p>
          We met through <strong>Mullet Militia</strong> over a shared love of third-gen F-bodies. As it turned out, we both had a <strong>1986 Pontiac Trans Am</strong> as our very first car.
        </p>
        <p>
          Even better: <strong>we both still have them today</strong>—and both of our ’86 Trans Ams are now <strong>LS-powered</strong>.
        </p>
      </div>

      <div class="origin-stats">
        <div class="stat-box">
          <span class="stat-num">1986</span>
          <span class="stat-label">First Car for Both Hosts</span>
        </div>
        <div class="stat-box">
          <span class="stat-num">LS V8</span>
          <span class="stat-label">Modern Heart Swapped</span>
        </div>
        <div class="stat-box">
          <span class="stat-num">F-Body</span>
          <span class="stat-label">Mullet Militia Roots</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 5.5rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .section-intro {
    max-width: 620px;
    margin-bottom: 3rem;
  }

  .section-lead {
    color: var(--text-secondary);
    font-size: 1.08rem;
    margin-top: 0.65rem;
  }

  .hosts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .host-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease;
  }

  .host-card:hover {
    border-color: var(--border-hover);
  }

  .host-role {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-amber);
    margin-bottom: 0.35rem;
  }

  .host-name {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .host-bio {
    color: var(--text-secondary);
    font-size: 0.98rem;
    margin-bottom: 1.75rem;
    flex: 1;
  }

  .host-tags {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .tag-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .tag-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .tag-value {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Origin Card */
  .origin-card {
    background: linear-gradient(135deg, #14171f 0%, #101218 100%);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 2.75rem;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
  }

  .origin-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .origin-text p {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 0.85rem;
  }

  .origin-text strong {
    color: var(--text-primary);
  }

  .origin-stats {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .stat-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    padding: 1.1rem 1.35rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .stat-num {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-red);
  }

  .stat-label {
    font-size: 0.88rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  @media (max-width: 860px) {
    .hosts-grid,
    .origin-card {
      grid-template-columns: 1fr;
    }
    .host-tags {
      grid-template-columns: 1fr;
    }
    .origin-card {
      padding: 2rem;
      gap: 2rem;
    }
  }
</style>
