---
import { SITE_CONFIG } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="pit-radio" class="contact-section">
  <div class="container">
    <div class="contact-wrapper">
      <div class="contact-info">
        <div class="dash-tag">PIT RADIO // OPEN CHANNEL</div>
        <h2 class="section-title">GOT A BUILD STORY OR <span>GUEST PITCH?</span></h2>
        <p class="contact-lead">
          Want to come on the show, share a third-gen F-body or LS-swap nightmare, suggest a topic, or sponsor an episode? Key up the mic and drop James &amp; Chris a line.
        </p>

        <div class="contact-cards">
          <div class="mini-card">
            <img
              src={`${base}/images/high-octane-dads-podcast-check-engine-logo.png`}
              alt="Check Engine Logo"
              width="48"
              height="48"
            />
            <div>
              <h4>DIAGNOSTIC / CAR TALK</h4>
              <p>Tell us what’s leaking, smoking, or currently on jackstands in your driveway.</p>
            </div>
          </div>

          <div class="mini-card">
            <img
              src={`${base}/images/high-octane-dads-est-qr.png`}
              alt="High Octane Dads Badge"
              width="48"
              height="48"
            />
            <div>
              <h4>DIRECT EMAIL</h4>
              <p>
                <a href={`mailto:${SITE_CONFIG.email}`}>{SITE_CONFIG.email}</a>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Netlify & Mailto Fallback Form -->
      <div class="form-panel">
        <div class="form-panel-header">
          <span>TRANSMISSION FORM // PIT RADIO</span>
          <span>CH 86.0</span>
        </div>

        <form
          name="pit-radio-contact"
          method="POST"
          action={`mailto:${SITE_CONFIG.email}`}
          enctype="text/plain"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="pit-form"
        >
          <input type="hidden" name="form-name" value="pit-radio-contact" />
          <p class="hidden-honey">
            <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
          </p>

          <div class="form-row">
            <div class="form-group">
              <label for="name">YOUR NAME / HANDLE</label>
              <input type="text" id="name" name="name" required placeholder="e.g. T-Top Tommy" />
            </div>
            <div class="form-group">
              <label for="email">EMAIL ADDRESS</label>
              <input type="email" id="email" name="email" required placeholder="you@garage.com" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="ride">WHAT’S IN YOUR GARAGE?</label>
              <input type="text" id="ride" name="ride" placeholder="e.g. 1986 Trans Am, OBS Chevy, Mini Truck..." />
            </div>
            <div class="form-group">
              <label for="topic">REASON FOR TRANSMISSION</label>
              <select id="topic" name="topic">
                <option value="Listener Shoutout / Car Story">Listener Shoutout / Car Story</option>
                <option value="Podcast Guest Pitch">Podcast Guest Pitch</option>
                <option value="Sponsorship / Merch Inquiry">Sponsorship / Merch Inquiry</option>
                <option value="Mullet Militia / F-Body Talk">Mullet Militia / F-Body Talk</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="message">MESSAGE FOR JAMES &amp; CHRIS</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Tell us about your project car, topic idea, or question for the next Saturday episode..."
            ></textarea>
          </div>

          <button type="submit" class="submit-btn">
            <span>SEND TRANSMISSION</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 5rem 0;
  }

  .contact-wrapper {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-lead {
    color: var(--text-secondary);
    margin: 1rem 0 2rem;
    font-size: 1.02rem;
  }

  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mini-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-steel);
    border-radius: 8px;
    padding: 1rem 1.25rem;
  }

  .mini-card h4 {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--amber-cel);
    letter-spacing: 0.05em;
  }

  .mini-card p {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .mini-card a {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .form-panel {
    background: var(--bg-card);
    border: 1px solid var(--border-steel);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5);
  }

  .form-panel-header {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 1.5rem;
    background: #0c0e14;
    border-bottom: 1px solid var(--border-steel);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--transam-gold);
    font-weight: 700;
  }

  .pit-form {
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .hidden-honey {
    display: none;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    background: #0c0e14;
    border: 1px solid var(--border-steel);
    border-radius: 5px;
    padding: 0.75rem 0.9rem;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--amber-dash);
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--red-octane);
    color: #fff;
    border: none;
    border-radius: 5px;
    padding: 0.95rem 1.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-style: italic;
    font-size: 1rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .submit-btn:hover {
    background: #ff2c31;
    transform: translateY(-2px);
  }

  @media (max-width: 860px) {
    .contact-wrapper,
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
