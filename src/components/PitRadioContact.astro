---
import { SITE_CONFIG } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="contact" class="contact-section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-copy">
        <span class="eyebrow">Get in Touch</span>
        <h2 class="section-heading">Guest Pitches, Build Stories &amp; Sponsors</h2>
        <p class="contact-lead">
          Want to share your project car story, come on the show, or partner with High Octane Dads? Send James and Chris a note below.
        </p>

        <div class="cel-callout">
          <img
            src={`${base}/images/high-octane-dads-podcast-check-engine-logo.png`}
            alt="High Octane Dads Check Engine Light"
            width="52"
            height="52"
          />
          <div>
            <strong>Direct Email</strong>
            <p><a href={`mailto:${SITE_CONFIG.email}`}>{SITE_CONFIG.email}</a></p>
          </div>
        </div>
      </div>

      <form
        name="pit-radio-contact"
        method="POST"
        action={`mailto:${SITE_CONFIG.email}`}
        enctype="text/plain"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="contact-form"
      >
        <input type="hidden" name="form-name" value="pit-radio-contact" />
        <p class="hidden-honey">
          <label>Don’t fill this out: <input name="bot-field" /></label>
        </p>

        <div class="field-row">
          <div class="field">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required placeholder="Your name" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required placeholder="you@example.com" />
          </div>
        </div>

        <div class="field">
          <label for="ride">What’s in your garage?</label>
          <input type="text" id="ride" name="ride" placeholder="e.g. 1986 Trans Am, OBS Truck, Daily Driver..." />
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder="Tell us about your build, topic idea, or inquiry..."
          ></textarea>
        </div>

        <button type="submit" class="send-btn">Send Message</button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 5.5rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 3.5rem;
    align-items: start;
  }

  .contact-lead {
    color: var(--text-secondary);
    font-size: 1.05rem;
    margin: 0.85rem 0 2rem;
  }

  .cel-callout {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 1rem 1.35rem;
  }

  .cel-callout strong {
    display: block;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .cel-callout a {
    font-size: 0.92rem;
    color: var(--text-secondary);
    text-decoration: underline;
  }

  .contact-form {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hidden-honey {
    display: none;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .field label {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .field input,
  .field textarea {
    background: var(--bg-main);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 0.8rem 1rem;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: border-color 0.2s ease;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--border-hover);
  }

  .send-btn {
    align-self: flex-start;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    border: none;
    background: var(--text-primary);
    color: #090a0d;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .send-btn:hover {
    background: #e2e8f0;
    transform: translateY(-1px);
  }

  @media (max-width: 860px) {
    .contact-grid,
    .field-row {
      grid-template-columns: 1fr;
    }
    .contact-form {
      padding: 1.5rem;
    }
  }
</style>
