---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import EpisodeGrid from '../components/EpisodeGrid.astro';
import MerchSpotlight from '../components/MerchSpotlight.astro';
import Footer from '../components/Footer.astro';
import { getPodcastEpisodes } from '../utils/rss';
import { SITE_CONFIG } from '../config';

const episodes = await getPodcastEpisodes();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base || '/';
---

<Layout
  title={`All Episodes (${episodes.length}) — ${SITE_CONFIG.title}`}
  description="Stream all episodes of the High Octane Dads Podcast with James Schoepf and Chris Mayo."
>
  <Header />
  <main>
    <section class="archive-top">
      <div class="container">
        <a href={homeUrl} class="back-link">← Back to Home</a>
      </div>
    </section>
    <EpisodeGrid episodes={episodes} showViewAll={false} />
    <MerchSpotlight />
  </main>
  <Footer />
</Layout>

<style>
  .archive-top {
    padding: 2.5rem 0 0;
  }

  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .back-link:hover {
    color: var(--text-primary);
  }
</style>
