---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import EpisodeGrid from '../components/EpisodeGrid.astro';
import MeetTheDads from '../components/MeetTheDads.astro';
import MerchSpotlight from '../components/MerchSpotlight.astro';
import PitRadioContact from '../components/PitRadioContact.astro';
import Footer from '../components/Footer.astro';
import { getPodcastEpisodes } from '../utils/rss';

const allEpisodes = await getPodcastEpisodes();
const latestEpisode = allEpisodes[0];
const recentEpisodes = allEpisodes.slice(0, 6);
---

<Layout>
  <Header />
  <main>
    <Hero latestEpisode={latestEpisode} />
    <EpisodeGrid episodes={recentEpisodes} showViewAll={true} />
    <MeetTheDads />
    <MerchSpotlight />
    <PitRadioContact />
  </main>
  <Footer />
</Layout>
